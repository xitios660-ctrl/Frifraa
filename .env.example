# Bots work locally without a key or external requests.
BOT_AI_PROVIDER=local
# Optional: configuring a real xAI key and changing provider to grok enables billable API usage.
XAI_API_KEY=
XAI_MODEL=grok-4.7

# Gemini: set BOT_AI_PROVIDER=gemini to opt in. This model offers a free tier subject to account quotas.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
